Date: Fri, 22 Sep 2023 01:13:31 +0300
Subject: [PATCH] [EasyEVSE-LF6.1.36]DTS support for i.MX8MMLPDDR4 and i.MX8MP

Signed-off-by: OTS <octavian-tiberiu.sirbu@nxp.com>
---
 arch/arm64/boot/dts/freescale/Makefile        |  2 +
 .../imx8mm-evk-evse-ph1_2-cg5317.dts          | 41 ++++++++++
 .../boot/dts/freescale/imx8mm-evk-evse.dts    | 76 +++++++++++++++++++
 .../imx8mp-evk-evse-ph1_2-cg5317.dts          | 58 ++++++++++++++
 .../boot/dts/freescale/imx8mp-evk-evse.dts    | 75 ++++++++++++++++++
 5 files changed, 252 insertions(+)
 create mode 100644 arch/arm64/boot/dts/freescale/imx8mm-evk-evse-ph1_2-cg5317.dts
 create mode 100644 arch/arm64/boot/dts/freescale/imx8mm-evk-evse.dts
 create mode 100644 arch/arm64/boot/dts/freescale/imx8mp-evk-evse-ph1_2-cg5317.dts
 create mode 100644 arch/arm64/boot/dts/freescale/imx8mp-evk-evse.dts

diff --git a/arch/arm64/boot/dts/freescale/Makefile b/arch/arm64/boot/dts/freescale/Makefile
index cca79473023c..ebb6890dd323 100644
--- a/arch/arm64/boot/dts/freescale/Makefile
+++ b/arch/arm64/boot/dts/freescale/Makefile
@@ -79,6 +79,7 @@ dtb-$(CONFIG_ARCH_MXC) += imx8mm-evk-ak4497.dtb imx8mm-evk-ak5558.dtb imx8mm-evk
 dtb-$(CONFIG_ARCH_MXC) += imx8mm-evk-8mic-revE.dtb imx8mm-evk-8mic-swpdm.dtb \
 			  imx8mm-evk-iqaudio-dacplus.dtb imx8mm-evk-iqaudio-dacpro.dtb imx8mm-evk-hifiberry-dacplus.dtb \
 			  imx8mm-evk-hifiberry-dac2.dtb imx8mm-evk-hifiberry-dacplusadc.dtb
+dtb-$(CONFIG_ARCH_MXC) += imx8mm-evk-evse.dtb imx8mm-evk-evse-ph1_2-cg5317.dtb
 dtb-$(CONFIG_ARCH_MXC) += imx8mm-ddr4-evk.dtb imx8mm-ddr4-evk-rm67191.dtb imx8mm-ddr4-evk-revb.dtb \
 			  imx8mm-ddr4-evk-revb-rm67191.dtb \
 			  imx8mm-ddr4-evk-revb-rm67191-cmd-ram.dtb \
@@ -132,6 +133,7 @@ dtb-$(CONFIG_ARCH_MXC) += imx8mp-phyboard-pollux-rdk.dtb
 dtb-$(CONFIG_ARCH_MXC) += imx8mp-ab2.dtb
 dtb-$(CONFIG_ARCH_MXC) += imx8mp-ddr4-evk.dtb
 dtb-$(CONFIG_ARCH_MXC) += imx8mp-evk-ndm.dtb
+dtb-$(CONFIG_ARCH_MXC) += imx8mp-evk-evse.dtb imx8mp-evk-evse-ph1_2-cg5317.dtb
 
 imx8mp-evk-revb4-dtbs := imx8mp-evk.dtb imx8mp-evk-revb4.dtbo
 imx8mp-evk-revb4-rm67191-dtbs := imx8mp-evk-rm67191.dtb imx8mp-evk-revb4.dtbo
diff --git a/arch/arm64/boot/dts/freescale/imx8mm-evk-evse-ph1_2-cg5317.dts b/arch/arm64/boot/dts/freescale/imx8mm-evk-evse-ph1_2-cg5317.dts
new file mode 100644
index 000000000000..8760ddbfb6e6
--- /dev/null
+++ b/arch/arm64/boot/dts/freescale/imx8mm-evk-evse-ph1_2-cg5317.dts
@@ -0,0 +1,41 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright 2023 NXP
+ */
+
+/dts-v1/;
+
+#include "imx8mm-evk-evse.dts"
+
+/delete-node/ &nxpnfc;
+
+&ecspi2 {
+	pinctrl-2 = <&pinctrl_cg5317>;	
+	spidev0: spi@0 {
+		compatible = "lwn,bk4";
+		reg = <0x0>;
+		spi-cpha;
+		spi-max-frequency = <8000000>;
+		spi-cpol;
+	};
+};
+
+&i2c3 {
+	nxpnfc: nxpnfc@28 {
+		compatible = "nxp,nxpnfc";
+		reg = <0x28>;
+		nxp,nxpnfc-irq = <&gpio3 23 GPIO_ACTIVE_HIGH>;
+		nxp,nxpnfc-ven = <&gpio3 21 GPIO_ACTIVE_HIGH>;
+		nxp,nxpnfc-fw-dwnld = <&gpio3 20 GPIO_ACTIVE_HIGH>;
+	};
+};
+
+&iomuxc {
+	pinctrl_cg5317: cg5317grp {
+                fsl,pins = <
+                        MX8MM_IOMUXC_ECSPI1_SS0_GPIO5_IO9           0x100
+                        MX8MM_IOMUXC_ECSPI1_MISO_GPIO5_IO8          0x100
+                >;
+        };
+
+};
\ No newline at end of file
diff --git a/arch/arm64/boot/dts/freescale/imx8mm-evk-evse.dts b/arch/arm64/boot/dts/freescale/imx8mm-evk-evse.dts
new file mode 100644
index 000000000000..55478f533855
--- /dev/null
+++ b/arch/arm64/boot/dts/freescale/imx8mm-evk-evse.dts
@@ -0,0 +1,76 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright 2023 NXP
+ */
+
+/dts-v1/;
+
+#include "imx8mm-evk.dts"
+
+/delete-node/ &spidev0;
+
+&adv_bridge {
+	status = "disabled";
+};
+
+&ecspi2 {
+	nxpnfc: nxpnfc@0 {
+		compatible = "nxp,nxpnfc";
+		reg = <0>;
+		nxp,nxpnfc-irq = <&gpio3 23 GPIO_ACTIVE_HIGH>;
+		nxp,nxpnfc-ven = <&gpio3 21 GPIO_ACTIVE_HIGH>;
+		nxp,nxpnfc-fw-dwnld = <&gpio3 20 GPIO_ACTIVE_HIGH>;
+		spi-max-frequency = <7000000>;
+	};
+};
+
+&i2c2 {
+	touchscreen@14 {
+		compatible = "goodix,gt1151";
+		reg = <0x14>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_i2c2_synaptics_dsx_io>;
+		interrupt-parent = <&gpio1>;
+		interrupts = <9 IRQ_TYPE_EDGE_FALLING>;
+		irq-gpios = <&gpio1 9 GPIO_ACTIVE_HIGH>;
+		edge-failling-trigger;
+		touchscreen-size-x = <1080>;
+		touchscreen-size-y = <1920>;
+	};
+};
+
+&micfil {
+	status = "disabled";
+};
+
+&mipi_dsi {
+	panel@0 {
+		compatible = "raydium,rm67199";
+		reg = <0>;
+		pinctrl-0 = <&pinctrl_mipi_dsi_en>;
+		reset-gpio = <&gpio1 8 GPIO_ACTIVE_LOW>;
+		dsi-lanes = <4>;
+		video-mode = <2>;	/* 0: burst mode
+					 * 1: non-burst mode with sync event
+					 * 2: non-burst mode with sync pulse
+					 * 3: command mode
+					 */
+		panel-width-mm = <68>;
+		panel-height-mm = <121>;
+		status = "okay";
+	};
+};
+
+&uart3 {
+	/delete-property/ uart-has-rtscts;
+	pinctrl-0 = <&pinctrl_uart3_meter>;
+};
+
+&iomuxc {
+	pinctrl_uart3_meter: uart3grp {
+		fsl,pins = <
+			MX8MM_IOMUXC_ECSPI1_SCLK_UART3_DCE_RX           0x140
+			MX8MM_IOMUXC_ECSPI1_MOSI_UART3_DCE_TX           0x140
+		>;
+	};
+};
