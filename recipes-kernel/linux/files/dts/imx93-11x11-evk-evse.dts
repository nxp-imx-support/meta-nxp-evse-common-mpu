/dts-v1/;

#include "imx93-11x11-evk.dts"

/delete-node/ &dsi_to_adv7535;
/delete-node/ &adv7535_to_dsi;

/ {
        sw_keys {
                compatible = "gpio-keys";

                btn1: pause {
                        label = "Pause";
                        gpios = <&pcal6524 5 GPIO_ACTIVE_LOW>;
                        linux,code = <KEY_PAUSE>;
                        interrupt-parent = <&pcal6524>;
                        interrupts = <5 IRQ_TYPE_LEVEL_LOW>;
                };

                btn2: new {
                        label = "New";
                        gpios = <&pcal6524 6 GPIO_ACTIVE_LOW>;
                        linux,code = <KEY_NEW>;
                        interrupt-parent = <&pcal6524>;
                        interrupts = <6 IRQ_TYPE_LEVEL_LOW>;
                };
        };
};

&adv7535 {
	status = "disabled";
};

&dsi {
	#address-cells = <1>;
	#size-cells = <0>;

	panel@0 {
		compatible = "raydium,rm67199";
		reg = <0>;
		reset-gpio = <&adp5585 6 GPIO_ACTIVE_LOW>;
		dsi-lanes = <4>;
		video-mode = <2>;	/* 0: burst mode
					 * 1: non-burst mode with sync event
					 * 2: non-burst mode with sync pulse
					 */
		width-mm = <68>;
		height-mm = <121>;
		status = "okay";

		port {
			panel_in: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
	};

	ports {
		port@1 {
			reg = <1>;

			dsi_out: endpoint {
				remote-endpoint = <&panel_in>;
			};
		};
	};
};

&lcdif {
	assigned-clock-rates = <484000000>, <121000000>, <400000000>, <133333333>;
};

&lpi2c1 {
	touchscreen@14 {
		compatible = "goodix,gt1151";
		reg = <0x14>;
		interrupt-parent = <&pcal6524>;
		interrupts = <7 IRQ_TYPE_EDGE_FALLING>;
		irq-gpios = <&pcal6524 7 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&adp5585 9 GPIO_ACTIVE_HIGH>;
		edge-failling-trigger;
		touchscreen-size-x = <1080>;
		touchscreen-size-y = <1920>;
	};
};

&lpspi6 {
	fsl,spi-num-chipselects = <1>;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_lpspi6 &pinctrl_lpspi6_cs>;
	pinctrl-1 = <&pinctrl_lpspi6 &pinctrl_lpspi6_cs>;
	cs-gpios = <&gpio2 0 GPIO_ACTIVE_LOW>;
	status = "okay";

	nxpnfc: nxpnfc@0 {
		compatible = "nxp,nxpnfc";
		reg = <0>;
		nxp,nxpnfc-irq = <&gpio2 22 GPIO_ACTIVE_HIGH>;
		nxp,nxpnfc-ven = <&gpio2 23 GPIO_ACTIVE_HIGH>;
		nxp,nxpnfc-fw-dwnld = <&gpio2 24 GPIO_ACTIVE_HIGH>;
		spi-max-frequency = <7000000>;
	};	
};

&lpuart3 { /* Meter Board*/
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart3>;
	status = "okay";
};

&xcvr {
	status = "disabled";
};

&iomuxc {
	pinctrl_lpspi6: lpspi6grp {
		fsl,pins = <
			MX93_PAD_GPIO_IO01__LPSPI6_SIN		0x3fe
			MX93_PAD_GPIO_IO02__LPSPI6_SOUT		0x3fe
			MX93_PAD_GPIO_IO03__LPSPI6_SCK		0x3fe
		>;
	};

	pinctrl_lpspi6_cs: lpspi6cs {
		fsl,pins = <
			MX93_PAD_GPIO_IO00__GPIO2_IO00		0x3fe
		>;
	};

	pinctrl_uart3: uart3grp {
		fsl,pins = <
			MX93_PAD_GPIO_IO14__LPUART3_TX		0x31e
			MX93_PAD_GPIO_IO15__LPUART3_RX		0x31e
		>;
	};
};
