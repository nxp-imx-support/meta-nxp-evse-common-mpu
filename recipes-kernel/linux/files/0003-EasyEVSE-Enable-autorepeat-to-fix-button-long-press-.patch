From cc0332e674b0079c8a5a7cdd81cd8f573c9f85fe Mon Sep 17 00:00:00 2001
From: Winteri Wang <dongjie.wang@nxp.com>
Date: Wed, 5 Mar 2025 11:31:28 +0900
Subject: [PATCH 3/3] [EasyEVSE] Enable autorepeat to fix button long press
 issue

---
 arch/arm64/boot/dts/freescale/imx93-11x11-evk-evse-lvds.dts | 3 +++
 arch/arm64/boot/dts/freescale/imx93-11x11-evk-evse.dts      | 3 +++
 2 files changed, 6 insertions(+)

diff --git a/arch/arm64/boot/dts/freescale/imx93-11x11-evk-evse-lvds.dts b/arch/arm64/boot/dts/freescale/imx93-11x11-evk-evse-lvds.dts
index 664216df880d..7ab9f9a10a14 100644
--- a/arch/arm64/boot/dts/freescale/imx93-11x11-evk-evse-lvds.dts
+++ b/arch/arm64/boot/dts/freescale/imx93-11x11-evk-evse-lvds.dts
@@ -44,6 +44,9 @@ panel_lvds_in: endpoint {
 	};
 	sw_keys {
 		compatible = "gpio-keys";
+		autorepeat;
+		repeat-delay = <250>;
+		repeat-period = <33>;
 
 		btn1: pause {
 			label = "Pause";
diff --git a/arch/arm64/boot/dts/freescale/imx93-11x11-evk-evse.dts b/arch/arm64/boot/dts/freescale/imx93-11x11-evk-evse.dts
index 7aa8e1dbbd55..fe4654375a3c 100644
--- a/arch/arm64/boot/dts/freescale/imx93-11x11-evk-evse.dts
+++ b/arch/arm64/boot/dts/freescale/imx93-11x11-evk-evse.dts
@@ -13,6 +13,9 @@
 / {
         sw_keys {
                 compatible = "gpio-keys";
+		autorepeat;
+		repeat-delay = <250>;
+		repeat-period = <33>;
 
                 btn1: pause {
                         label = "Pause";
-- 
2.25.1

