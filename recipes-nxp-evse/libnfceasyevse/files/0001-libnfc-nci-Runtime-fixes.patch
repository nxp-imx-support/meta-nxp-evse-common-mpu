From a14da41bd2b7746c41b94377873b48e7a8a08684 Mon Sep 17 00:00:00 2001
From: Ionut Vicovan <Ionut.Vicovan@nxp.com>
Date: Sat, 28 Sep 2024 00:57:02 +0300
Subject: [PATCH] [libnfc-nci] Fix build and runtime crashes

Signed-off-by: Andraz Skupek <Andraz.Skupek@nxp.com>
Signed-off-by: OTS <Octavian-Tiberiu.Sirbu@nxp.com>
Signed-off-by: Ionut Vicovan <Ionut.Vicovan@nxp.com>
---
 src/android/utility/base/strings.cpp                         | 2 +-
 src/nfcandroid_nfc_hidlimpl/halimpl/utils/NfccPowerTracker.h | 1 +
 src/nxp_nci_hal_libnfc-nci/src/include/Nxp_Features.h        | 2 ++
 src/nxp_nci_hal_libnfc-nci/utils/config.cc                   | 3 +++
 src/nxp_nci_hal_libnfc-nci/utils/include/config.h            | 1 +
 src/service/linux_nfc_api.cpp                                | 2 +-
 6 files changed, 9 insertions(+), 2 deletions(-)

diff --git a/src/android/utility/base/strings.cpp b/src/android/utility/base/strings.cpp
index 374f7d8..ca4256d 100644
--- a/src/android/utility/base/strings.cpp
+++ b/src/android/utility/base/strings.cpp
@@ -24,7 +24,7 @@ std::vector<std::string> android::base::Split(const std::string& s, const std::s
 	std::string str(s);
 	std::string  token(delimiters);
 	while (str.size()) {
-		unsigned int index = str.find(token);
+		size_t index = str.find(token);
 		if (index != std::string::npos) {
 			result.push_back(str.substr(0, index));
 			str = str.substr(index + token.size());
diff --git a/src/nfcandroid_nfc_hidlimpl/halimpl/utils/NfccPowerTracker.h b/src/nfcandroid_nfc_hidlimpl/halimpl/utils/NfccPowerTracker.h
index 3b3e8c0..d0a09ec 100644
--- a/src/nfcandroid_nfc_hidlimpl/halimpl/utils/NfccPowerTracker.h
+++ b/src/nfcandroid_nfc_hidlimpl/halimpl/utils/NfccPowerTracker.h
@@ -17,6 +17,7 @@
  ******************************************************************************/
 #pragma once
 
+#include <cstdint>
 #include <string>
 #include <time.h>
 #include <vector>
diff --git a/src/nxp_nci_hal_libnfc-nci/src/include/Nxp_Features.h b/src/nxp_nci_hal_libnfc-nci/src/include/Nxp_Features.h
index b6741ad..c075aa7 100644
--- a/src/nxp_nci_hal_libnfc-nci/src/include/Nxp_Features.h
+++ b/src/nxp_nci_hal_libnfc-nci/src/include/Nxp_Features.h
@@ -18,6 +18,8 @@
 
 #ifndef NXP_FEATURES_H
 #define NXP_FEATURES_H
+
+#include <cstdint>
 #include <unistd.h>
 #include <string>
 
diff --git a/src/nxp_nci_hal_libnfc-nci/utils/config.cc b/src/nxp_nci_hal_libnfc-nci/utils/config.cc
index d4b6f20..9029273 100644
--- a/src/nxp_nci_hal_libnfc-nci/utils/config.cc
+++ b/src/nxp_nci_hal_libnfc-nci/utils/config.cc
@@ -867,6 +867,9 @@ extern "C" int GetStrValue(const char* name, char* pValue, unsigned long l)
 
     switch (len)
     {
+    case sizeof(unsigned int):
+        *(static_cast<unsigned int*>(pValue)) = (unsigned int)v;
+        break;
     case sizeof(unsigned long):
         *(static_cast<unsigned long*>(pValue)) = (unsigned long)v;
         break;
diff --git a/src/nxp_nci_hal_libnfc-nci/utils/include/config.h b/src/nxp_nci_hal_libnfc-nci/utils/include/config.h
index f4bcdec..7b928a2 100644
--- a/src/nxp_nci_hal_libnfc-nci/utils/include/config.h
+++ b/src/nxp_nci_hal_libnfc-nci/utils/include/config.h
@@ -15,6 +15,7 @@
  */
 #pragma once
 
+#include <cstdint>
 #include <map>
 #include <string>
 #include <vector>
diff --git a/src/service/linux_nfc_api.cpp b/src/service/linux_nfc_api.cpp
index e9229de..63af088 100644
--- a/src/service/linux_nfc_api.cpp
+++ b/src/service/linux_nfc_api.cpp
@@ -379,7 +379,7 @@ int doWriteT4tData(unsigned char *command, unsigned char *ndef_buffer, int ndef_
 int doReadT4tData(unsigned char *command, unsigned char *ndef_buffer, int *ndef_buffer_length)
 {
     int ret = 0;
-    if (ndef_buffer == NULL || ndef_buffer_length <= 0) {
+    if (ndef_buffer == NULL || *ndef_buffer_length <= 0) {
       NXPLOG_API_E ("%s: invalide buffer!", __FUNCTION__);
       return NFA_STATUS_FAILED;
     }
-- 
